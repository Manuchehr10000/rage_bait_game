{
  "name": "lost-tourist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/check-assets.mjs && vite build",
    "preview": "vite preview",
    "api": "vite build && wrangler pages dev dist --port 8788 --d1 DB --compatibility-date 2025-09-01",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "assets:check": "node tools/check-assets.mjs",
    "map:coastlines": "node tools/build-coastlines.mjs",
    "map:monuments": "node tools/paint-monuments.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "wrangler": "^4.151.0"
  }
}
